# Copy this file to .env.local and fill in your own values.
# See SETUP-GUIDE.md for step-by-step instructions.

# ── Required — Supabase (database, auth, storage) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # server only — never expose to the client

# ── Required — Paystack (checkout) ───────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_dc0821ea68d0f003d3c3352220548dc03013a75d
NEXT_PUBLIC_PAYSTACK_SUBACCOUNT_CODE=ACCT_ud6yo2g3g2tczpr

# ── Required — site URL ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional — /control analytics dashboard (app/control, app/api/analytics) ─
CONTROL_PASSWORD=

# ── Optional — Facebook / Meta Pixel + Conversions API (app/api/capi) ───────
NEXT_PUBLIC_FB_PIXEL_ID=
FB_CAPI_TOKEN=

# =============================================================================
# The variables below are read by the Supabase Edge Functions in
# supabase/functions/ (Deno runtime), NOT by the Next.js app. Set them as
# Supabase project secrets — `supabase secrets set KEY=value` — not here.
# =============================================================================

# Order confirmation / status emails (Resend)
# DT_RESEND_API_KEY=
# DT_RESEND_WEBHOOK_SECRET=
# DT_FROM_EMAIL=
# SHOP_FROM_EMAIL=
# SHOP_SUPPORT_EMAIL=

# Paystack webhook backstop (central-paystack-webhook, diamond-paystack-webhook)
DT_PAYSTACK_SECRET=your-paystack-secret-key
DT_PAYSTACK_SUBACCOUNT=ACCT_ud6yo2g3g2tczpr
DT_PAYSTACK_LIVE=your-paystack-secret-key

# AI email marketing + Instagram bot (advanced/optional — see SETUP-GUIDE.md
# "Optional extras". These functions also need database tables that are not
# part of schema.sql or schema-crm-extensions.sql.)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Supabase project (usually auto-injected by the Supabase CLI at deploy time)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
